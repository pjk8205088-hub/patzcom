EBAY_ENV=production
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_REDIRECT_URI=https://www.patzcom.com/api/ebay/callback
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.fulfillment https://api.ebay.com/oauth/api_scope/sell.account
EBAY_APP_SCOPES=https://api.ebay.com/oauth/api_scope
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_LISTING_SITE=US
EBAY_AUTH_CODE=
EBAY_REFRESH_TOKEN=
EBAY_IMAGE_ENRICH_LIMIT=0

# Required for PATZCOM Seller Hub listing edits and uploads. Use a unique password (12+ chars).
PATZCOM_ADMIN_EMAIL=partscombined@gmail.com
PATZCOM_ADMIN_PASSWORD=replace-with-a-unique-12-character-password

PAYPAL_CLIENT_ID=your-paypal-live-client-id
PAYPAL_CLIENT_SECRET=your-paypal-live-client-secret
PAYPAL_ENV=live
PATZCOM_PUBLIC_URL=https://www.patzcom.com
PATZCOM_SHIPPING_FLAT=0

STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
